{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "outDir": "./node_modules/.tmp/node",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "moduleDetection": "force",
    "strict": true,
    // Pin ambient type libraries. Without this, tsc auto-includes every
    // node_modules/@types directory it finds walking up the tree, which in a
    // git worktree reaches the parent checkout and picks up junk there.
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}

# Anon-key-only. Service-role material must NEVER appear here or in the client bundle (law 8).
VITE_SUPABASE_URL=https://your-supabase-host
VITE_SUPABASE_ANON_KEY=your-anon-key
# hub-service API base (W3 writes). Pre-cutover this points at the n8n gateway; flips at P6.
VITE_HUB_API_BASE=https://hub-service.example
# Workbench URL for the client_admin / super_admin handoff screen.
VITE_WORKBENCH_URL=https://workbench-admin.zeabur.app

# Anon-key-only. Service-role material must NEVER appear here or in the client bundle (law 8).
VITE_SUPABASE_URL=https://your-supabase-host
VITE_SUPABASE_ANON_KEY=your-anon-key
# hub-service API base (W3 writes) — the origin the composer POSTs /api/agent-send to.
# ⚠ SA-01b: .env.production is gitignored, so it does NOT reach the Zeabur build. This value
# must be set as a Zeabur SERVICE env var, and it is baked at BUILD time — setting it without
# a rebuild changes nothing. Empty here resolves same-origin and 404s.
# Measured 2026-07-30: a process env var beats a .env.production value in both directions.
VITE_HUB_API_BASE=https://hub-service-sb.zeabur.app
# Shared anti-noise gateway value. This is shipped in the public browser bundle;
# Supabase JWT + tenant membership + role remain the authorization boundary.
# Keep it aligned with hub-service PM_GATEWAY_KEY and rotate both together.
VITE_PM_GATEWAY_KEY=
# Workbench URL for the client_admin / super_admin handoff screen.
VITE_WORKBENCH_URL=https://workbench-admin.zeabur.app
